<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Sweet Rings</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <h1>🍩 Sweet Rings</h1>
  <p>Donat manis untuk setiap suasana</p>

  <div class="products" id="product-list"></div>

  <h2>🛒 Keranjang</h2>
  <div id="cart"></div>
  <h3>Total: Rp <span id="total">0</span></h3>

  <button onclick="checkout()">Checkout</button>

  <!-- QRIS Modal -->
  <div id="qrisModal" class="modal">
    <div class="modal-content">
      <h2>Scan QRIS</h2>
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=SweetRingsPayment">
      <p>Total: Rp <span id="qrisTotal"></span></p>
      <button onclick="confirmPayment()">Saya Sudah Bayar</button>
      <button onclick="closeModal()">Batal</button>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>
